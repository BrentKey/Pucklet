{
  "name": "pucklet",
  "productName": "Pucklet",
  "version": "0.1.0",
  "description": "Open-source desktop app for making clean scientific figures.",
  "author": "Brent",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:mac": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "icon": "electron scripts/render-icon.cjs",
    "icons": "npm run icons:bioicons && npm run icons:reactome && npm run icons:phylopic && npm run icons:healthicons && npm run icons:swissbiopics && npm run icons:scidraw && npm run icons:anatomograms && npm run icons:iconify-science && npm run icons:arcadia && npm run icons:biodraws",
    "icons:bioicons": "node scripts/icons-bioicons.mjs",
    "icons:reactome": "node scripts/icons-reactome.mjs",
    "icons:phylopic": "node scripts/icons-phylopic.mjs",
    "icons:healthicons": "node scripts/icons-healthicons.mjs",
    "icons:swissbiopics": "node scripts/icons-swissbiopics.mjs",
    "icons:scidraw": "node scripts/icons-scidraw.mjs",
    "icons:anatomograms": "node scripts/icons-anatomograms.mjs",
    "icons:iconify-science": "node scripts/icons-iconify-science.mjs",
    "icons:arcadia": "node scripts/icons-arcadia.mjs",
    "icons:biodraws": "node scripts/icons-biodraws.mjs",
    "icons:togotv": "node scripts/icons-togotv.mjs",
    "icons:openclipart-science": "node scripts/icons-openclipart-science.mjs"
  },
  "build": {
    "appId": "org.pucklet.app",
    "productName": "Pucklet",
    "files": [
      "out/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "pucklet",
        "name": "Pucklet Figure",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "icon": "build/icon.png",
    "copyright": "Copyright © 2026 Brent",
    "dmg": {
      "title": "Pucklet"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "fractional-indexing": "^4.0.0",
    "papaparse": "^5.7.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.12",
    "yjs": "^13.6.33",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "homepage": "https://github.com/BrentKey/Pucklet"
}
