{
  "name": "pucklet",
  "productName": "Pucklet",
  "version": "0.1.0",
  "description": "Open-source desktop app for making clean scientific figures.",
  "author": "Brent",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:mac": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "icon": "electron scripts/render-icon.cjs",
    "icons": "npm run icons:bioicons && npm run icons:reactome && npm run icons:phylopic",
    "icons:bioicons": "node scripts/icons-bioicons.mjs",
    "icons:reactome": "node scripts/icons-reactome.mjs",
    "icons:phylopic": "node scripts/icons-phylopic.mjs"
  },
  "build": {
    "appId": "org.pucklet.app",
    "productName": "Pucklet",
    "files": [
      "out/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "pucklet",
        "name": "Pucklet Figure",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "icon": "build/icon.png",
    "copyright": "Copyright \u00a9 2026 Brent",
    "dmg": {
      "title": "Pucklet"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "fractional-indexing": "^4.0.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yjs": "^13.6.33",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "homepage": "https://github.com/BrentKey/Pucklet"
}
